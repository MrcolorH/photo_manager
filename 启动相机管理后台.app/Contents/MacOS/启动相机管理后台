#!/bin/bash

# 智能检测项目根目录
# 策略1: 检查 .app 是否在项目根目录中
APP_CONTENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="$(cd "$APP_CONTENTS_DIR/.." && pwd)"
POTENTIAL_PROJECT_ROOT="$APP_DIR"

# 检查 start.sh 是否在 .app 的父目录
if [ -f "$POTENTIAL_PROJECT_ROOT/start.sh" ]; then
    SCRIPT_PATH="$POTENTIAL_PROJECT_ROOT"
else
    # 策略2: 使用硬编码的默认路径（作为后备）
    DEFAULT_PATH="/Users/colorh/Project/Node后端/相机管理后台"
    if [ -f "$DEFAULT_PATH/start.sh" ]; then
        SCRIPT_PATH="$DEFAULT_PATH"
    else
        # 策略3: 让用户选择
        SELECTED_PATH=$(osascript <<'EOF'
tell application "System Events"
    set chosenFolder to choose folder with prompt "请选择相机管理后台项目文件夹:" default location (path to home folder)
    return POSIX path of chosenFolder
end tell
EOF
)
        if [ -n "$SELECTED_PATH" ] && [ -f "$SELECTED_PATH/start.sh" ]; then
            SCRIPT_PATH="$SELECTED_PATH"
        else
            osascript <<EOF
tell application "System Events"
    display dialog "错误：找不到 start.sh 文件\n\n请在选择的文件夹中包含 start.sh" buttons {"确定"} default button 1 with icon stop
end tell
EOF
            exit 1
        fi
    fi
fi

START_SCRIPT="$SCRIPT_PATH/start.sh"

# 检查 start.sh 是否存在
if [ ! -f "$START_SCRIPT" ]; then
    osascript <<EOF
tell application "System Events"
    display dialog "错误：找不到 start.sh 文件\n\n请确保应用程序位于项目根目录中。\n\n期望位置：\n$SCRIPT_PATH" buttons {"确定"} default button 1 with icon stop
end tell
EOF
    exit 1
fi

# 在后台启动服务（隐藏终端）
nohup bash "$START_SCRIPT" > /tmp/camera-launcher.log 2>&1 &
LAUNCHER_PID=$!

# 等待服务启动并获取前端端口（优化：减少等待时间）
FRONTEND_PORT=5173
for i in {1..20}; do
    # 检查前端端口是否已开放
    for port in 5173 5174 5175; do
        if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then
            FRONTEND_PORT=$port
            break 2
        fi
    done
    
    # 如果端口还没开放，尝试从日志读取
    if [ -f /tmp/frontend.log ]; then
        DETECTED_PORT=$(grep -o 'Local:[[:space:]]*http://localhost:[0-9]*' /tmp/frontend.log 2>/dev/null | grep -o '[0-9]*$' | head -1)
        if [ -n "$DETECTED_PORT" ]; then
            FRONTEND_PORT=$DETECTED_PORT
            break
        fi
    fi
    
    sleep 0.5
done

# 等待1秒让服务完全启动
sleep 1

# 自动在默认浏览器中打开
osascript <<EOF
tell application "System Events"
    set frontendURL to "http://localhost:$FRONTEND_PORT"
    
    -- 获取默认浏览器
    set defaultBrowser to (do shell script "defaults read com.apple.LaunchServices/com.apple.launchservices.secure | awk -F'\"' '/http;/{print \$4}' | head -1")
    
    if defaultBrowser is not "" then
        tell application id defaultBrowser
            activate
            open location frontendURL
        end tell
    else
        -- 如果无法获取默认浏览器，使用 Safari
        tell application "Safari"
            activate
            open location frontendURL
        end tell
    end if
end tell
EOF

# 显示通知
osascript <<EOF
tell application "System Events"
    display notification "相机管理后台已启动！\n前端地址: http://localhost:$FRONTEND_PORT" with title "✅ 启动成功" sound name "Glass"
end tell
EOF

exit 0

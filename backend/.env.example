# 拾光 Capsule 后端环境变量示例
#
# 使用方式：
#   1. 复制本文件为 backend/.env（.env 已被 .gitignore 忽略，不会提交）
#   2. 按需修改以下配置项，留空则使用代码中的平台兜底默认值
#
# 各平台默认兜底值（无需配置 .env 也能运行）：
#   PORT                Windows / macOS 均为 3001
#   PHOTO_BASE_PATH     Windows: ~/Pictures/CameraPhotos
#                       macOS:   /Users/colorh/Pictures/相机照片
#   DEFAULT_IMPORT_PATH Windows: C:\
#                       macOS:   /Volumes

# 服务端口
PORT=3001

# 照片库根路径（留空则使用系统兜底默认值）
PHOTO_BASE_PATH=

# 默认导入入口路径（留空则使用系统兜底默认值）
DEFAULT_IMPORT_PATH=
